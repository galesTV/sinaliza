# Supabase — configure apenas depois que o projeto estiver provisionado (ver AGENTS.md §10-13
# e supabase/README.md). Somente a chave *publishable* pode aparecer aqui;
# chaves *secret* (`sb_secret_*`) NUNCA devem estar neste arquivo nem chegar ao navegador.
#
# Sem estas variáveis (ou com os placeholders abaixo), o app roda em modo
# convidado: progresso fica só no localStorage e nenhuma chamada ao Supabase
# é feita. Copie para `.env.local` e preencha os valores reais.
NEXT_PUBLIC_SUPABASE_URL=https://rrkyugefpydskajfilws.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Liberação editorial da entrada "Explorar" na navegação principal.
# Mesmo como true, a entrada só aparece quando houver ao menos um registro
# publicável em cada categoria cultural. Não use para publicar rascunhos.
SINALIZA_EXPLORE_LAUNCHED=false
